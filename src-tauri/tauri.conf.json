{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edit Master",
  "version": "0.9.1",
  "identifier": "com.editmaster.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Edit Master",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon-m.ico",
      "icons/icon-m-32.png",
      "icons/icon-m-128.png",
      "icons/icon-m-256.png"
    ]
  }
}
